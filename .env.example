# Copy to .env and adjust. The app auto-loads .env at startup.
# Never commit real secrets or certs.
CCA_HOST=0.0.0.0
CCA_PORT=443
CCA_SSL_CERT=certs/server.crt
CCA_SSL_KEY=certs/server.key
CCA_SECRET_KEY=set-a-stable-random-value-in-production
CCA_DATA_DIR=data
OPENAI_API_KEY=sk-your-key-here
CCA_REALTIME_MODEL=gpt-realtime-2.1
CCA_GRADING_MODEL=gpt-4o
